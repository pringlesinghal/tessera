Bootstrap: docker
From: continuumio/miniconda3

%post
    conda init
    # Create envs and install packages
    conda create --name tesseraenv
    
    . /opt/conda/etc/profile.d/conda.sh
    conda activate tesseraenv
    conda install -y -c conda-forge fiona pyproj proj rasterio rioxarray dask dask[distributed] numpy affine shapely geopandas xarray bokeh gdal netcdf4 libnetcdf pytorch cpuonly pyarrow pandas
    conda install pip
    pip install stackstac pystac-client planetary-computer joblib psutil tqdm urllib3 requests earthengine-api geographiclib
    pip install zarr
    # some special environment things for singularity
    echo ". /opt/conda/etc/profile.d/conda.sh" >> $SINGULARITY_ENVIRONMENT
    echo "conda activate tesseraenv" >> $SINGULARITY_ENVIRONMENT
%runscript
    exec "$@"
