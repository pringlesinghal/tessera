Bootstrap: docker
From: pytorch/pytorch:2.1.2-cuda12.1-cudnn8-runtime

%post
    # Update apt and install basics
    apt-get update && apt-get install -y git wget

    # Install Python dependencies
    # Derived from imports in tessera-util/src/{train.py, dataset.py, models/, utils/}
    # and train_ssl_multi_gpu.py requirements
    # Note: No requirements.txt found in source, so using latest compatible versions.
    pip install --upgrade pip
    pip install pandas numpy pyarrow scikit-learn wandb einops matplotlib tqdm scipy
    
    # Additional dependencies for FSDP training script
    pip install fvcore  # For FLOPs counting in train_ssl_multi_gpu.py
    
    # Verify torchrun is available
    which torchrun || echo "Warning: torchrun not found in PATH"
    python -c "import torch; print(f'PyTorch version: {torch.__version__}')" || echo "Warning: PyTorch import failed"

%environment
    export LC_ALL=C
    export LANG=C.UTF-8
    export PATH=/opt/conda/bin:$PATH
    export PYTHONPATH=/opt/conda/lib/python3.10/site-packages:$PYTHONPATH

%runscript
    exec "$@"
